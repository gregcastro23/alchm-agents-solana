      "water": 1,
      "air": 1.5,
      "earth": 0,
      "expectedHeat": 0.47337278106508873,
      "expectedEntropy": 1.453125,
      "expectedReactivity": 33.25,
      "expectedGregsEnergy": -47.84303346893491
    },
    {
      "name": "Essence non-zero - where the missing-Essence entropy bug shows",
      "spirit": 2.3350306237,
      "essence": 4.8425751978,
      "matter": 3.7395648213,
      "substance": 1.1769853687,
      "fire": 2,
      "water": 4,
      "air": 2.4,
      "earth": 1.6,
      "expectedHeat": 0.0299707405942846,
      "expectedEntropy": 0.08252079315305037,
      "expectedReactivity": 1.9658479370591309,
      "expectedGregsEnergy": -0.13225259039012274
    },
    {
      "name": "all axes zero - every denominator falls back to 1",
      "spirit": 0,
      "essence": 0,
      "matter": 0,
      "substance": 0,
      "fire": 0,
      "water": 0,
      "air": 0,
      "earth": 0,
      "expectedHeat": 0,
