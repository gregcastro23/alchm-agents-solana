# ── Arc testnet deploy for the Pentacle Star Vaults stack ──────────────────
# Copy to contracts/.env and fill DEPLOYER_PRIVATE_KEY. (contracts/.env is gitignored.)
#
# FAST DEMO PATH: use ONE funded wallet for both deployer and attestor.
#   1. Create/throwaway an EVM wallet.
#   2. Fund it with Arc-testnet USDC (USDC is Arc's GAS token) via the Circle Arc faucet.
#   3. Paste its private key below. Leave ATTESTOR_ADDRESS blank -> deploy uses the
#      deployer address as attestor automatically.

# Funded Arc-testnet deployer key (also the attestor in the fast path). 0x-prefixed.
DEPLOYER_PRIVATE_KEY=

# Attestor that gets ATTESTOR_ROLE on vault + AMM. Leave blank to reuse the deployer.
# MUST match the wallet behind the backend's ARC_ATTESTOR_PRIVATE_KEY.
ATTESTOR_ADDRESS=

# ESMS NFT metadata base URI (placeholder is fine for the demo).
ESMS_METADATA_URI=https://alchmagents.eth.limo/esms/{id}.json

# Arc testnet RPC (forge's `arc` endpoint reads ARC_RPC_URL).
ARC_RPC_URL=https://rpc.testnet.arc.network

# Arc's pre-deployed USDC gas token — leave as default unless Circle changes it.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
