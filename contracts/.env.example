# ── Arc testnet deploy for the Pentacle Star Vaults stack ──────────────────
# Copy to contracts/.env and fill the values. (contracts/.env is gitignored.)
#
# Separation of duties (hardened): the deployer is admin/upgrader/pauser only and is
# NEVER a minter; the attestor and the permanent minter are SEPARATE addresses. Fund
# the deployer with Arc-testnet USDC (USDC is Arc's GAS token) via the Circle Arc faucet.

# Funded Arc-testnet deployer key. Becomes DEFAULT_ADMIN / UPGRADER / PAUSER only. 0x-prefixed.
DEPLOYER_PRIVATE_KEY=

# Attestor that gets ATTESTOR_ROLE on vault + AMM ONLY (the hot feeder key — keep it off
# the admin/minter surface). MUST match the wallet behind the backend's ARC_ATTESTOR_PRIVATE_KEY.
ATTESTOR_ADDRESS=

# Permanent ESMS MINTER_ROLE holder (the backend claim/yield key). MUST be distinct from
# the deployer and the attestor.
MINTER_ADDRESS=

# Merkle root committing the stakeable HIP star ids. Generate with:
#   bun run scripts/compute-star-root.ts
STAR_REGISTRY_ROOT=

# Optional: max ESMS (18-dp) mintable per 1 USDC of principal per day (yield cap).
# Defaults to 5e16 (0.05/day) if unset.
# MAX_YIELD_RATE_PER_USDC_PER_DAY=50000000000000000

# ESMS NFT metadata base URI (placeholder is fine for the demo).
ESMS_METADATA_URI=https://alchmagents.eth.limo/esms/{id}.json

# Arc testnet RPC (forge's `arc` endpoint reads ARC_RPC_URL).
ARC_RPC_URL=https://rpc.testnet.arc.io

# Arc's pre-deployed USDC gas token — leave as default unless Circle changes it.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
