# ==============================================================================
# Planetary Agents (AlchmAgentsSolana) - Solana Mainnet Production Environment
# Program ID: 5QheuqaicKvPPRFEoEXwaE5xaFp7gauvJCfsjpQv8WzD
# Runtime: Bun | Network: Solana Mainnet-Beta | Genesis: 5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 2. SOLANA MAINNET NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Strictly enforced: SOLANA_NETWORK must be "mainnet-beta" in production.
# The app will fail-closed and throw on boot if set to "devnet" or omitted.
SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Primary Solana Mainnet RPC endpoint (Helius / QuickNode / Triton / Alchemy)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Comma-separated RPC failover list for automatic health monitoring and rotation
SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployed Anchor Program ID
SOLANA_PROGRAM_ID=5QheuqaicKvPPRFEoEXwaE5xaFp7gauvJCfsjpQv8WzD
NEXT_PUBLIC_SOLANA_PROGRAM_ID=5QheuqaicKvPPRFEoEXwaE5xaFp7gauvJCfsjpQv8WzD

# ------------------------------------------------------------------------------
# 3. CLOUD KMS HSM SIGNING CONFIGURATION (AWS KMS / GCP Cloud KMS)
# ------------------------------------------------------------------------------
# Private keys MUST NEVER exist in memory or environment files on Mainnet.
# Configure AWS KMS (Ed25519) or GCP Cloud KMS (ED25519).
SOLANA_ALLOW_LOCAL_PAYER_IN_PROD=false

# --- AWS KMS Configuration ---
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-ed25519-kms-key-id
# Public key corresponding to the AWS KMS Ed25519 key (base58 format)
SOLANA_SERVICE_PUBLIC_KEY=YourKmsDerivedPublicKeyBase58Here

# --- GCP Cloud KMS Configuration (Alternative) ---
# GCP_KMS_KEY_NAME=projects/your-project-id/locations/global/keyRings/your-ring/cryptoKeys/your-key/cryptoKeyVersions/1
# SOLANA_SERVICE_PUBLIC_KEY=YourKmsDerivedPublicKeyBase58Here

# ------------------------------------------------------------------------------
# 4. SQUADS V4 MULTISIG & GOVERNANCE AUTHORITIES
# ------------------------------------------------------------------------------
# Squads v4 Multisig PDA and Vault PDA for administrative control
SQUADS_MULTISIG_PDA=
SQUADS_VAULT_PDA=

# Configured attestor and emergency pauser public keys
SOLANA_ATTESTOR_PUBKEY=
SOLANA_PAUSER_PUBKEY=

# 32-byte cluster domain bound into all AMM attestation preimages
# If omitted, defaults to sha256("ASOL_MAINNET_V1")
# SOLANA_CLUSTER_DOMAIN=0x...

# ------------------------------------------------------------------------------
# 5. TOKEN-2022 DETERMINISTIC ESMS MINT ADDRESSES
# ------------------------------------------------------------------------------
# Derived from seeds: [b"esms_mint", &[0..3]]
SOLANA_ESMS_MINT_SPIRIT=K5kwwomtWYydxJacA7bC5yUEW9TtEuVqBKBoqAWLmhQ
SOLANA_ESMS_MINT_ESSENCE=3FcpToU7bj4sLD687uecbesEjzjxBfqYn2EcBXJKPaCf
SOLANA_ESMS_MINT_MATTER=7naJZozLrknDF3dguAdEWn7Z4MviUkXitjhaAt57Vkb4
SOLANA_ESMS_MINT_SUBSTANCE=6RY6ZG1eJQ2uEvpyA6XK74WyF1MpTYbw97hdhELqDUsa

# ------------------------------------------------------------------------------
# 6. TRANSACTION FINALITY & SYNC SERVICE SETTINGS
# ------------------------------------------------------------------------------
# Mainnet reconciliation strictly enforces 'finalized' commitment
SOLANA_COMMITMENT=finalized
SOLANA_SYNC_OUTBOX_POLL_INTERVAL_MS=1000
SOLANA_SYNC_BATCH_SIZE=25
SOLANA_SERVICE_HEARTBEAT_STALE_MS=45000

# Bearer authentication for the outbox webhook dispatcher
SOLANA_SERVICE_AUTH_TOKEN=your-random-64-character-hex-auth-token-here
SOLANA_SYNC_WEBHOOK_URL=https://api.planetaryagents.com/api/solana/sync
SOLANA_SYNC_WEBHOOK_BEARER_TOKEN=your-random-64-character-hex-webhook-token-here

# ------------------------------------------------------------------------------
# 7. PRIORITY FEE & COMPUTE BUDGET ENGINE
# ------------------------------------------------------------------------------
# Dynamic priority fee cap in micro-lamports per Compute Unit
SOLANA_PRIORITY_FEE_MAX_MICROLAMPORTS=1500000
SOLANA_PRIORITY_FEE_PERCENTILE=75
SOLANA_COMPUTE_UNIT_LIMIT=400000
