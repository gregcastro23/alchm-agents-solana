{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Token-2022 ESMS Metadata Manifest",
  "description": "JSON Schema for AlchmAgentsSolana Token-2022 off-chain elemental manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "symbol", "description", "image", "decimals", "attributes"],
  "properties": {
    "name": {
      "type": "string",
      "enum": ["Spirit", "Essence", "Matter", "Substance"]
    },
    "symbol": {
      "type": "string",
      "enum": ["SPIRIT", "ESSENCE", "MATTER", "SUBSTANCE"]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "image": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^https://arweave\\.net/[A-Za-z0-9_-]{43}$"
        }
      ]
    },
    "decimals": {
      "type": "integer",
      "const": 4
    },
    "attributes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": {
            "type": "string"
          },
          "value": {
            "type": ["string", "number"]
          }
        }
      }
    }
  }
}
