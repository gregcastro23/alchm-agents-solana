# ── Identity Auth (Google / NextAuth) ────────────────────────────────────────
# Two modes for user (Google) sign-in — see docs/AUTH.md:
#   • Local (recommended): agents.alchm.kitchen runs its OWN Google OAuth so
#     login stays on this domain. Requires the three vars below + an authorized
#     redirect URI https://agents.alchm.kitchen/api/auth/callback/google on the
#     Google OAuth client, then flip NEXT_PUBLIC_AGENTS_LOCAL_AUTH=true.
#   • Legacy fallback (flag unset): sign-in bounces to alchm.kitchen's Google
#     handler. This is the current prod behavior and the source of the
#     "redirected to the kitchen profile" bug.
NEXT_PUBLIC_AGENTS_LOCAL_AUTH=false          # set "true" once the vars below are configured
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
NEXTAUTH_URL=https://agents.alchm.kitchen    # this app's own origin (localhost:3000 in dev)
AUTH_SECRET=your_nextauth_secret             # shared with alchm.kitchen for a consistent JWT

# ── Internal service-to-service auth ─────────────────────────────────────────
# Shared by the Next.js proxies (admin MCP telemetry, lib/backend.ts) and the
# FastAPI backend. Must be set to the SAME value in Vercel AND Railway.
# No code fallback exists — unset means those calls fail closed (401/503).
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Dynamic Auth (on-chain wallet connect — separate from identity login above)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_env_id_here

# Privy (Agent Wallets)
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Circle (Arc App Kit)
# The frontend integration uses Dynamic context, but you might need these for backend operations
CIRCLE_API_KEY=your_circle_api_key

# ── Coinbase AgentKit / CDP (per-agent wallets on Base) ──────────────────────
# Each agent gets its own MPC-custodied CDP wallet so it can receive x402 USDC
# and settle autonomously. Create keys at portal.cdp.coinbase.com. Independently
# optional — with these unset, agent-wallet provisioning is a no-op (returns null).
# See lib/agentkit/agent-wallet.ts. Requires the `agent_wallets` migration.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK_ID=base-sepolia        # base-sepolia (default) | base | ethereum-sepolia | ...

# ── On-chain ESMS (soulbound ERC-1155 on Base) ───────────────────────────────
# Set after deploying contracts/src/EsmsToken.sol. The ESMS Bazaar (/shop) reads
# balances and settles digital purchases with a real on-chain burn against these.
NEXT_PUBLIC_ESMS_CHAIN=base-sepolia        # or "base"
ESMS_CONTRACT_ADDRESS=                      # EsmsToken proxy address (enables on-chain settlement)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ── Solana Devnet (AAE ESMS + PersonaCommitment) ────────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Server workers try these in order, then fall back to the public Devnet RPC.
SOLANA_RPC_URL=
HELIUS_SOLANA_RPC_URL=
QUICKNODE_SOLANA_RPC_URL=
SOLANA_RPC_URLS=
# Base58 or JSON-array 64-byte service-writer key. In local development only,
# the JEPA worker may read SOLANA_AGENT_PAYER_PATH / ANCHOR_WALLET / the Solana
# CLI default wallet. Production never reads a local-wallet fallback.
SOLANA_AGENT_PAYER_KEY=
SOLANA_AGENT_PAYER_PATH=
JEPA_ANCHOR_AGENT_IDS=
JEPA_ANCHOR_ACTIVE_WINDOW_HOURS=24
JEPA_PERSONA_ANCHOR_INTERVAL_MS=300000
JEPA_COSMIC_EPOCH_INTERVAL_MS=60000
SOLANA_SERVICE_HEARTBEAT_STALE_MS=45000
NEXT_PUBLIC_BASE_SEPOLIA_ESMS_ADDRESS=0x124ECa1bb1E106D3614A22A256f9A412FfeEAd8F
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Alchm recipe provenance protocol (set after DeployRecipeProtocol.s.sol).
NEXT_PUBLIC_ALCHM_RIGHTS_REGISTRY_ADDRESS=
NEXT_PUBLIC_RECIPE_REGISTRY_ADDRESS=

# Backend settlement (BURNER_ROLE) wallet — sponsors gas so users burn ESMS
# without holding native balance. Reuses the minter wallet when one key holds
# both MINTER_ROLE and BURNER_ROLE.
PRIVY_REDEEMER_WALLET_ID=                   # preferred: Privy server wallet id (no raw key)
# REDEEMER_PRIVATE_KEY=0x...                # local/testnet fallback signer

# Where food orders hand off (the alchm.kitchen restaurant payment route).
NEXT_PUBLIC_ALCHM_KITCHEN_URL=https://alchm.kitchen

# ── Arc Testnet (Circle) ─────────────────────────────────────────────────────
# Used for x402 settlement and ERC-8004 agent registration.
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# USDC on Arc (gas token)
X402_ASSET=0x3600000000000000000000000000000000000000

# ── Pentacle Star Vaults (Arc testnet / EVM chain 5042002) ──────────────────
# Canonical public deployment. These are also checked-in defaults; override all four
# together after a redeploy. Never point one address at a different chain/deployment.
NEXT_PUBLIC_ARC_ESMS_ADDRESS=0x124ECa1bb1E106D3614A22A256f9A412FfeEAd8F
NEXT_PUBLIC_STAR_VAULT_ADDRESS=0x34eAC0fe797df2889d9dc59Cb98dCe24154BB9B6
NEXT_PUBLIC_CONSTELLATION_DEED_ADDRESS=0x6B4EE164320e9E5583C0F6BEe14D5BABb5ba5095
NEXT_PUBLIC_CONSTELLATION_AMM_ADDRESS=0x34d860Cb460ecD2595584138d22Ad6fe7DAeA3BB

# Server-only signer holding ATTESTOR_ROLE on StarVault + ConstellationAMM.
# secp256k1, signs EIP-712 typed data on Arc.
# ARC_ATTESTOR_PRIVATE_KEY=0x...

# Solana attestor for the Constellation AMM (Phase 6). NOT interchangeable with
# ARC_ATTESTOR_PRIVATE_KEY: this path verifies an **Ed25519** signature against
# ProgramConfig.attestor through the Solana Ed25519 precompile, so it needs the
# Ed25519 keypair that `initialize_config` named. Accepts a 64-byte JSON array
# (what `solana-keygen` writes), a base58 secret key, or a path to a keypair file.
# Consumed by app/api/solana/amm-attestation/route.ts.
# SOLANA_ATTESTOR_KEYPAIR=

# The 32-byte hex cluster_domain recorded in ProgramConfig, bound into every AMM
# attestation preimage so a signature minted for one cluster cannot be spent on
# another. Must match what `initialize_config` was given for this deployment; a
# mismatch produces signatures the program rejects.
# SOLANA_CLUSTER_DOMAIN=
STAKING_BASE_DAILY_RATE=0.0006
STAKING_CLAIM_WINDOW_DAYS=1
NEXT_PUBLIC_ASC_ACTIVATION_ORB_ARCMIN=2

# Pentacles live sky engine (deployed SpacetimeDB Maincloud module).
NEXT_PUBLIC_SPACETIME_URI=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_MODULE=cookingwithcastrollc
NEXT_PUBLIC_SPACETIME_LIVE_FEED=true
NEXT_PUBLIC_SPACETIME_LIVE_ORACLE=true

# ASOL Pentacles gameplay controller (backend only).
# The owner token must belong to GameConfig.owner. Never expose it as NEXT_PUBLIC_*.
PENTACLES_SPACETIME_URI=https://maincloud.spacetimedb.com
PENTACLES_SPACETIME_DATABASE=cookingwithcastrollc
PENTACLES_SPACETIME_OWNER_TOKEN=
PENTACLES_AGENT_CONTROLLER_ENABLED=false
PENTACLES_AGENT_DRY_RUN=true
PENTACLES_AGENT_INTERVAL_MS=10000
PENTACLES_AGENT_MAX_AGENTS=100
PENTACLES_AGENT_MAX_ACTIONS=25
PENTACLES_AGENT_DUELS_ENABLED=true
PENTACLES_CONTROLLER_URL=

# Local-only input to `bun run generate:pentacles-bindings`; the script also
# accepts `--module /absolute/path/to/Pentacles/server`.
PENTACLES_MODULE_PATH=../Spacetimedbhackathon/Pentacles/server
