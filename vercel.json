{
  "installCommand": "bun install",
  "buildCommand": "bun run prisma:generate && bun run build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": true
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NODE_VERSION": "22.x"
    }
  },
  "crons": [
    {
      "path": "/api/cron/agents/claim-yield",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/agents/tick",
      "schedule": "28 * * * *"
    },
    {
      "path": "/api/cron/scrabble/tick",
      "schedule": "52 * * * *"
    },
    {
      "path": "/api/cron/push-feed",
      "schedule": "14,44 * * * *"
    },
    {
      "path": "/api/cron/agents/refresh-reservoirs",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/agents/announce-weekly-feature",
      "schedule": "22 0 * * 1"
    },
    {
      "path": "/api/cron/agents/weekly-menu",
      "schedule": "9 5 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=60, stale-while-revalidate"
        }
      ]
    }
  ]
}
