  lastUsed         DateTime?
  createdAt        DateTime       @default(now())
  userProfileId    String?
  users            users?         @relation(fields: [creatorId], references: [id])
  user_profiles    user_profiles? @relation(fields: [userProfileId], references: [id])

  @@index([creatorId])
}

model historical_agents {
  id                     String                   @id @default(cuid())
  agentId                String                   @unique
  name                   String
  title                  String
  birthDate              DateTime
  birthTime              String
  birthLocation          Json
  historicalEra          String
  birthYear              Int
  deathYear              Int?
  culture                String
  geography              String
  consciousnessLevel     String
  kalchmConstant         Float
  monicaConstant         Float                    @default(0)
  dominantElement        String
  dominantModality       String?
  signature              String
  spiritScore            Float?
  essenceScore           Float?
  matterScore            Float?
  substanceScore         Float?
  personalityCore        Json
  personalityShadows     Json
  personalityGifts       Json
  personalityChallenges  Json
  currentMood            String
  evolutionStage         Int                      @default(0)
  background             Json
  specialty              String
  wisdomDomains          Json
  skills                 Json
  teachingStyle          String
  resonanceType          String
  uniquePower            String
  avatar                 String?
  color                  String
  symbol                 String
  aura                   Json?
  natalChart             Json
  traits                 Json
  monicaCreationStory    String?
  searchableText         String?
  powerScore             Float?                   @default(0)
  resonanceScore7        Float?                   @default(0)
  wisdomScore            Float?                   @default(0)
  charismaScore          Float?                   @default(0)
  intuitionScore         Float?                   @default(0)
  adaptabilityScore      Float?                   @default(0)
  vitalityScore          Float?                   @default(0)
  solarAgency            Float?                   @default(0)
  lunarReceptivity       Float?                   @default(0)
  mercurialVelocity      Float?                   @default(0)
  venusianCoherence      Float?                   @default(0)
  martialImpetus         Float?                   @default(0)
  jovianExpansion        Float?                   @default(0)
  saturnianStructure     Float?                   @default(0)
  chironicAdaptation     Float?                   @default(0)
  uranianSurprisal       Float?                   @default(0)
  neptunianResonance     Float?                   @default(0)
  plutonicIntegration    Float?                   @default(0)
  kineticAlignment       Float?                   @default(0)
  popularityScore        Float                    @default(0.5)
  conversations          Int                      @default(0)
  wisdomShared           Int                      @default(0)
  resonanceScore         Float                    @default(0.5)
  evolutionPoints        Int                      @default(0)
