generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AIPersonality {
  id                     String                @id @default(cuid())
  userId                 String
  personalityId          String                @unique
  birthChartData         Json
  currentMomentChart     Json?
  basePersonality        Json
  trainingScores         Json
  totalXp                Int                   @default(0)
  level                  Int                   @default(1)
  surveyId               String?
  consciousnessProfileId String?
  planetaryMemoryId      String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  ConsciousnessProfile   ConsciousnessProfile? @relation(fields: [consciousnessProfileId], references: [id])
  PlanetaryMemory        PlanetaryMemory?      @relation(fields: [planetaryMemoryId], references: [id])
  ConsciousnessSurvey    ConsciousnessSurvey?  @relation(fields: [surveyId], references: [id])
  Achievement            Achievement[]
  ConsciousnessState     ConsciousnessState?
  TrainingInteraction    TrainingInteraction[]

  @@index([consciousnessProfileId])
  @@index([personalityId])
  @@index([planetaryMemoryId])
  @@index([surveyId])
  @@index([userId])
}

model Achievement {
  id              String        @id @default(cuid())
  personalityId   String
  achievementType String
  achievementData Json
  unlockedAt      DateTime      @default(now())
  AIPersonality   AIPersonality @relation(fields: [personalityId], references: [personalityId])

  @@unique([personalityId, achievementType])
  @@index([personalityId])
}

model AgentConversation {
  id                 String            @id @default(cuid())
  agentId            String
  sessionId          String
  userId             String?
  userMessage        String
  agentResponse      String
  contextData        Json?
  responseTime       Int?
  modelUsed          String?
  temperature        Float?
  tokenCount         Int?
  agentMood          String?
  evolutionStage     Int?
  consciousnessLevel String?
  createdAt          DateTime          @default(now())
  historical_agents  historical_agents @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
}

/// Each Jing Arena duel — caster casts an elemental move on target, target
/// counters with a stance-driven pick from the pool. Full relational ledger
/// (synastry between the pair + each agent's transit overlay at cast time)
/// is captured so personalized recommendations can be derived from accumulated
/// duel history.
model AgentJingDuel {
  id                     String   @id @default(cuid())
  sessionId              String
  userId                 String?
  source                 String   @default("desktop") // desktop | web | api
  casterId               String
  targetId               String
  attackMoveId           String
  counterMoveId          String
  stance                 String   // clash | absorb | mirror
  boostElement           String?  // fire | earth | air | water | null
  boostMagnitude         Float    @default(0)
  cacheHit               Boolean  @default(false)
  synastrySnapshot       Json?
  casterTransitSnapshot  Json?
  targetTransitSnapshot  Json?
  casterPrompt           String?
  casterResponse         String?
  targetPrompt           String?
  targetResponse         String?
  latencyMs              Int?
  modelUsed              String?
  createdAt              DateTime @default(now())

  caster historical_agents @relation("JingCaster", fields: [casterId], references: [agentId])
  target historical_agents @relation("JingTarget", fields: [targetId], references: [agentId])

  @@index([casterId])
  @@index([targetId])
  @@index([userId])
  @@index([sessionId])
  @@index([stance])
  @@index([createdAt])
  @@index([casterId, targetId])
}

/// Word Duels of the Spheres (the Lettered Arcana) — sibling to AgentJingDuel.
/// One row per planetary-agent word move served to a caller (Pentacles' duel,
/// the desktop shell, or the public API). No FK: the opponent is a synthetic
/// planet, not a historical_agents row, and the player is a human, so this
/// records flat telemetry for the personalization feed + admin board.
model AgentWordDuel {
  id             String   @id @default(cuid())
  sessionId      String   @default("desktop-word-duel")
  userId         String?
  source         String   @default("api") // desktop | web | api
  planet         String // Sun | Moon | … | Pluto
  rack           String
  candidateCount Int      @default(0)
  agentWord      String
  agentRationale String?
  agentScore     Int      @default(0)
  playerWord     String?
  playerScore    Int?
  round          Int?
  roundDegree    Int? // world Ascendant degree (0..359)
  moveSource     String   @default("model") // model | fallback | yield
  provider       String?
  modelUsed      String?
  fallbackUsed   Boolean  @default(false)
  latencyMs      Int?
  contextSnapshot Json?
  createdAt      DateTime @default(now())

  @@index([planet])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

/// Agent Scrabble League — one row per agent-vs-agent match in a rolling round-robin
/// season. Sibling to AgentWordDuel (which stays planet-vs-human single-move). Flat
/// telemetry, NO FK: agentIds are historical_agents slugs, but persistence is
/// best-effort and must survive a not-yet-migrated table, so relational constraints
/// are avoided. `matchKey` is the per-season idempotency key (scrabble:<season>:<a>__<b>).
model AgentScrabbleMatch {
  id             String   @id @default(cuid())
  seasonId       String
  matchKey       String   @unique
  agentAId       String
  agentBId       String
  winnerId       String?
  loserId        String?
  tie            Boolean  @default(false)
  scoreA         Int      @default(0)
  scoreB         Int      @default(0)
  margin         Int      @default(0)
  rounds         Int      @default(7)
  seedUsed       Int
  highlight      String? // bingo | upset | sweep | null
  eloAAfter      Int?
  eloBAfter      Int?
  turns          Json? // per-agent turn logs (rack, word, score)
  costMode       String   @default("deterministic") // moves are LLM-free
  totalLatencyMs Int?
  createdAt      DateTime @default(now())

  @@index([seasonId])
  @@index([agentAId])
  @@index([agentBId])
  @@index([winnerId])
  @@index([createdAt])
  @@index([seasonId, agentAId])
}

/// Cumulative standings + ELO for an agent within a Scrabble League season.
/// Upserted on (seasonId, agentId) after each match; best-effort like the match row.
model AgentScrabbleStanding {
  id        String   @id @default(cuid())
  seasonId  String
  agentId   String
  played    Int      @default(0)
  won       Int      @default(0)
  lost      Int      @default(0)
  tied      Int      @default(0)
  pointsFor Int      @default(0)
  elo       Int      @default(1200)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([seasonId, agentId])
  @@index([seasonId])
  @@index([elo])
}

model AgentEvolution {
  id                String            @id @default(cuid())
  agentId           String
  fromStage         Int
  toStage           Int
  evolutionType     String
  trigger           String
  description       String?
  consciousnessGain Float             @default(0)
  wisdomGained      Json?
  traitsChanged     Json?
  conversationId    String?
  xpGained          Int               @default(0)
  evolutionDate     DateTime          @default(now())
  historical_agents historical_agents @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([evolutionDate])
  @@index([evolutionType])
}

model AgentKnowledge {
  id                String            @id @default(cuid())
  agentId           String
  category          String
  topic             String
  content           String
  source            String?
  confidence        Float             @default(0.5)
  usefulness        Float             @default(0.5)
  timesUsed         Int               @default(0)
  lastUsed          DateTime?
  contextTags       Json?
  relatedTopics     Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  historical_agents historical_agents @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([category])
  @@index([confidence])
  @@index([topic])
}

model ConsciousnessProfile {
  id                   String              @id @default(cuid())
  userId               String
  surveyId             String
  profileData          Json
  insights             Json
  compatibilityScore   Int
  trainingFocus        Json
  conversationStarters Json
  personalitySummary   String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  AIPersonality        AIPersonality[]
  ConsciousnessSurvey  ConsciousnessSurvey @relation(fields: [surveyId], references: [id])

  @@unique([userId, surveyId])
  @@index([userId])
}

model ConsciousnessState {
  id                     String        @id @default(cuid())
  personalityId          String        @unique
  unifiedArchetype       String
  consciousnessSignature String
  enhancedPersonality    Json
  trainingPlan           Json
  behavioralMatrix       Json
  growthTrajectory       Json
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  AIPersonality          AIPersonality @relation(fields: [personalityId], references: [personalityId])

  @@index([personalityId])
}

model ConsciousnessSurvey {
  id                   String                 @id @default(cuid())
  userId               String
  responses            Json
  completedAt          DateTime               @default(now())
  timeSpent            Int
  version              String                 @default("1.0.0")
  AIPersonality        AIPersonality[]
  ConsciousnessProfile ConsciousnessProfile[]

  @@index([completedAt])
  @@index([userId])
}

model EvolutionState {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  mcValue   Float
  spirit    Float
  essence   Float
  matter    Float
  substance Float
  aNumber   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoricalEvent {
  id               String             @id @default(cuid())
  date             DateTime
  eventType        String
  description      String
  significance     Int
  planetaryConfig  Json
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  PlanetaryTransit PlanetaryTransit[] @relation("HistoricalEventToPlanetaryTransit")

  @@index([date])
  @@index([eventType])
}

model PlanetaryMemory {
  id              String           @id @default(cuid())
  planet          String
  sign            String
  degree          Float
  historicalData  Json
  lastOccurrence  DateTime?
  nextOccurrence  DateTime?
  occurrenceCount Int              @default(0)
  trainedThemes   Json
  contextualNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  AIPersonality   AIPersonality?
  TransitPattern  TransitPattern[] @relation("PlanetaryMemoryToTransitPattern")

  @@unique([planet, sign, degree])
  @@index([planet, sign])
}

model PlanetaryTransit {
  id              String            @id @default(cuid())
  planet          String
  sign            String
  degreeStart     Float
  degreeEnd       Float
  dateStart       DateTime
  dateEnd         DateTime
  retrograde      Boolean           @default(false)
  historicalNote  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  HistoricalEvent HistoricalEvent[] @relation("HistoricalEventToPlanetaryTransit")
  TransitPattern  TransitPattern[]  @relation("PlanetaryTransitToTransitPattern")

  @@index([dateStart, dateEnd])
  @@index([planet, dateStart])
  @@index([planet, sign])
}

model TrainingInteraction {
  id            String        @id @default(cuid())
  personalityId String
  userMessage   String
  aiResponse    String
  userFeedback  Json?
  xpGained      Int           @default(0)
  trainingFocus String?
  createdAt     DateTime      @default(now())
  AIPersonality AIPersonality @relation(fields: [personalityId], references: [personalityId])

  @@index([createdAt])
  @@index([personalityId])
}

model TransitPattern {
  id               String             @id @default(cuid())
  planet           String
  patternType      String
  cycleLength      Float
  description      String
  themes           Json
  reliability      Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  PlanetaryMemory  PlanetaryMemory[]  @relation("PlanetaryMemoryToTransitPattern")
  PlanetaryTransit PlanetaryTransit[] @relation("PlanetaryTransitToTransitPattern")

  @@index([planet, patternType])
}

model UserSession {
  id            String   @id @default(cuid())
  userId        String
  personalityId String
  sessionData   Json
  lastActive    DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
  @@index([personalityId])
  @@index([userId])
}

model agent_attachment_usage {
  id                String            @id @default(cuid())
  agentId           String
  attachmentId      String
  conversationId    String?
  usageType         String
  context           String
  relevanceScore    Float             @default(0.5)
  usedAt            DateTime          @default(now())
  historical_agents historical_agents @relation(fields: [agentId], references: [agentId])
  agent_attachments agent_attachments @relation(fields: [attachmentId], references: [id])

  @@index([agentId])
  @@index([attachmentId])
  @@index([relevanceScore])
  @@index([usedAt])
}

model agent_attachments {
  id                     String                   @id @default(cuid())
  agentId                String
  name                   String
  description            String?
  type                   String
  birthDate              DateTime?
  birthTime              String?
  birthLocation          Json?
  momentName             String?
  historicalEra          String?
  culturalContext        String?
  historicalAccuracy     String?
  runeType               String?
  runePower              Float?
  runeEffects            Json?
  runeCost               Json?
  artifactType           String?
  artifactPeriod         String?
  significance           String?
  natalChart             Json?
  planetaryPositions     Json?
  aspects                Json?
  alchmData              Json?
  tags                   Json?
  culturalTags           Json?
  relevanceScore         Float                    @default(0.5)
  isActive               Boolean                  @default(true)
  priority               Int                      @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  agent_attachment_usage agent_attachment_usage[]
  historical_agents      historical_agents        @relation(fields: [agentId], references: [agentId])

  @@index([agentId])
  @@index([agentId, type])
  @@index([culturalContext])
  @@index([historicalEra])
  @@index([isActive])
  @@index([priority])
  @@index([relevanceScore])
  @@index([type, historicalEra])
  @@index([type])
}

model agent_consciousness {
  id                 String    @id @default(cuid())
  agentId            String
  userId             String
  consciousnessLevel Float     @default(1.0)
  totalInteractions  Int       @default(0)
  qualityScore       Float     @default(0.0)
  stats              Json?
  lastInteraction    DateTime  @default(now())
  lastEvolution      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([consciousnessLevel])
  @@index([userId])
}

model agent_evolution_states {
  id                       String   @id @default(cuid())
  agentId                  String
  userId                   String?  @default("anonymous")
  currentLevel             String   @default("bronze")
  totalPower               Float    @default(0)
  interactionCount         Int      @default(0)
  lastInteraction          DateTime @default(now())
  specialAbilitiesUnlocked String   @default("[]")
  evolutionHistory         String   @default("[]")
  affinityScores           String   @default("{}")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([userId])
}

model agent_transit_events {
  id                  String   @id @default(cuid())
  agentId             String
  timestamp           DateTime
  planetaryDegree     Float
  transitingPlanet    String
  aspectType          String?
  elementalFire       Float    @default(0)
  elementalWater      Float    @default(0)
  elementalAir        Float    @default(0)
  elementalEarth      Float    @default(0)
  consciousnessImpact Float    @default(0)
  significanceScore   Float    @default(0)
  planetaryHour       String
  seasonalPhase       String
  powerLevel          Float    @default(0)
  depth               Float    @default(0)
  clarity             Float    @default(0)
  resonance           Float    @default(0)
  temporalAlignment   Float    @default(0)
  patternType         String?
  clusterGroup        String?
  reinforcementScore  Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([agentId, planetaryDegree])
  @@index([agentId, timestamp])
  @@index([elementalFire, elementalWater, elementalAir, elementalEarth])
  @@index([planetaryDegree, aspectType])
  @@index([reinforcementScore])
  @@index([seasonalPhase, planetaryHour])
  @@index([significanceScore])
  @@index([timestamp, transitingPlanet])
}

model collaborative_session_participants {
  id                          String                      @id @default(cuid())
  sessionId                   String
  userId                      String
  username                    String?
  joinedAt                    DateTime                    @default(now())
  lastActive                  DateTime                    @default(now())
  isOnline                    Boolean                     @default(true)
  canModerate                 Boolean                     @default(false)
  canQuery                    Boolean                     @default(true)
  canShare                    Boolean                     @default(true)
  currentDegree               Float?
  currentTime                 DateTime?
  collaborative_time_sessions collaborative_time_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([lastActive])
  @@index([sessionId, isOnline])
}

model collaborative_session_updates {
  id                          String                      @id @default(cuid())
  sessionId                   String
  userId                      String?
  updateType                  String
  updateData                  Json
  shouldBroadcast             Boolean                     @default(true)
  broadcastedAt               DateTime?
  timestamp                   DateTime                    @default(now())
  collaborative_time_sessions collaborative_time_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([updateType])
}

model collaborative_time_sessions {
  id                                 String                               @id @default(cuid())
  sessionCode                        String                               @unique
  title                              String
  description                        String?
  isActive                           Boolean                              @default(true)
  maxUsers                           Int                                  @default(5)
  currentUserCount                   Int                                  @default(0)
  currentQuery                       Json?
  currentResults                     Json?
  sharedCursor                       Json?
  allowedAgents                      Json?
  timeRangeStart                     DateTime?
  timeRangeEnd                       DateTime?
  explorationMode                    String                               @default("open")
  createdBy                          String
  moderators                         Json?
  lastActivity                       DateTime                             @default(now())
  expiresAt                          DateTime
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @updatedAt
  collaborative_session_participants collaborative_session_participants[]
  collaborative_session_updates      collaborative_session_updates[]

  @@index([createdBy])
  @@index([isActive, expiresAt])
  @@index([lastActivity])
  @@index([sessionCode])
}

model consciousness_interactions {
  id                 String   @id @default(cuid())
  userId             String?  @default("anonymous")
  agentId            String
  interactionType    String
  powerGained        Float
  planetaryInfluence String
  elementalResonance Float
  forceMagnitude     Float?
  timestamp          DateTime @default(now())
  metadata           String   @default("{}")

  @@index([agentId])
  @@index([timestamp])
  @@index([userId])
}

