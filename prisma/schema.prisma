  AgentKnowledge         AgentKnowledge[]
  agent_attachment_usage agent_attachment_usage[]
  agent_attachments      agent_attachments[]
  mcp_invocations        mcp_invocations[]
  jingDuelsAsCaster      AgentJingDuel[]          @relation("JingCaster")
  jingDuelsAsTarget      AgentJingDuel[]          @relation("JingTarget")

  @@index([agentId])
  @@index([birthYear, culture])
  @@index([birthYear])
  @@index([consciousnessLevel])
  @@index([culture])
  @@index([dominantElement, consciousnessLevel])
  @@index([historicalEra, consciousnessLevel])
  @@index([historicalEra])
  @@index([isActive, historicalEra])
  @@index([isActive])
  @@index([kalchmConstant])
  @@index([monicaConstant])
  @@index([name])
  @@index([popularityScore])
}

model agent_action_events {
  id              String    @id @default(cuid())
  agentId         String
  agentEmail      String
  eventType       String
  triggerType     String
  triggerSummary  String
  metadataPayload Json
