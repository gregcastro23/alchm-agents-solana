model mcp_invocations {
  id            BigInt    @id @default(autoincrement())
  toolName      String    @map("tool_name")
  calledAt      DateTime  @default(now()) @map("called_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  latencyMs     Int?      @map("latency_ms")
  success       Boolean
  userId        String?   @map("user_id")
  apiKeyId      String?   @map("api_key_id")
  caller        String?
  arguments     Json?     @default("{}")
  resultSummary Json?     @default("{}") @map("result_summary")
  errorMessage  String?   @map("error_message")
  agentId       String?   @map("agent_id")
  modelTier     String?   @map("model_tier")

  user          users?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey        DesktopApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  agent         historical_agents? @relation(fields: [agentId], references: [agentId], onDelete: SetNull)

  @@index([toolName, calledAt(sort: Desc)])
  @@index([agentId, calledAt(sort: Desc)])
  @@index([userId, calledAt(sort: Desc)])
  @@index([calledAt(sort: Desc)])
  @@map("mcp_invocations")
}

// Transit-driven group chats. alchm.kitchen resolves a clicked transit to its two
// transiting degree-agent IDs and POSTs them to POST /api/internal/group-chat, which
// persists a session here and returns a /gallery/group/<id> URL. The group page
// hydrates the session and pre-populates the council. `userId` is best-effort
// cross-app attribution (an alchm.kitchen user that may not exist in this DB), so it
// is intentionally a bare String with no FK to `users`.
model group_chat_sessions {
  id         String    @id @default(cuid())
  agentIds   Json      @map("agent_ids")
  agents     Json?
  transit    Json?
  transitKey String?   @map("transit_key")
  // Deterministic "(transit, user, ~6h bucket)" key. A concurrent double-create
  // collides on this unique index instead of inserting two sessions; the loser reads
  // back the winner. NULL for keyless sessions (Postgres allows many NULLs here).
  dedupeKey  String?   @unique @map("dedupe_key")
  origin     String?
  source     String?
  userId     String?   @map("user_id")
  // Server-side one-time gate for the auto-convened council opener. Claimed atomically
  // (UPDATE ... WHERE seeded_at IS NULL) so the opener fires once per session even
  // across fresh browsers / incognito / cleared localStorage.
  seededAt   DateTime? @map("seeded_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([transitKey, userId])
  @@index([createdAt(sort: Desc)])
  @@map("group_chat_sessions")
}

// Coinbase AgentKit / CDP wallet provisioned per agent (Base). The address is the
// permanent source of truth — CDP's idempotencyKey is only stable for 24h, so once
// created we persist the address here and reconnect to it on subsequent loads.
// Also published as the agent's `agent-wallet[x402]` ENS record for payers.
model agent_wallets {
  agentId   String   @id @map("agent_id")
  address   String   @map("address")
  network   String   @default("base-sepolia") @map("network")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([address])
  @@map("agent_wallets")
}

/// World ID proof-of-personhood: one row per verified (human, action) —
/// the nullifier_hash is unique per human+app+action, so a PK on it enforces
/// sybil resistance across sessions. A nullifier binds to at most one user.
model world_id_verifications {
  nullifier         String   @id @map("nullifier")
  action            String   @map("action")
  userId            String?  @map("user_id")
  agentId           String?  @map("agent_id")
  verificationLevel String?  @map("verification_level")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([agentId])
  @@map("world_id_verifications")
}
